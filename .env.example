# Copy to `.env` and edit. `.env` is gitignored - never commit real keys.
# Everything here is optional; sane defaults are used when unset.

# ---- Where finished files are written ----
# NW_DOWNLOAD_DIR=/home/you/Downloads/Nw

# ---- Server ----
# NW_HOST=0.0.0.0
# NW_PORT=8000

# ---- Network behaviour (be polite to the host) ----
# NW_CONCURRENCY=4          # parallel HLS segments
# NW_MAX_RETRIES=3
# NW_TIMEOUT=30

# ---- Option B: use a third-party extraction API instead of direct scraping ----
# Leave these unset to use the built-in direct extractor.
# The key is read server-side only and is never sent to the browser.
# NW_API_URL=https://your-provider.example/api/v1/diskwala/extract
# NW_API_KEY=
# NW_API_METHOD=POST                  # POST or GET
# NW_API_AUTH_HEADER=Authorization    # Authorization | X-API-Key | (empty for none)
# NW_API_AUTH_PREFIX=Bearer           # Bearer | (empty)

# ---- Direct-extractor tuning (only if DiskWala changes their endpoints) ----
# NW_APP_ID=250528
# NW_CLIENTTYPE=0
